# Keep the small, frozen verified model as reproducibility evidence.
!/docs/verification/phase-c/runs/ml_main_01/selected_model.joblib

# Only these six reviewed submission screenshots are publishable.
/screenshots/*
!/screenshots/README.md
!/screenshots/01_airflow_dag_success.png
!/screenshots/02_airflow_graph.png
!/screenshots/06_langgraph_live_execution.png
!/screenshots/07_langgraph_conditional_retry.png
!/screenshots/08_regression_evaluation.png
